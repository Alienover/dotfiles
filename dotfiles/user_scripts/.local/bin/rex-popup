#!/usr/bin/env bash

# rex-popup - Run a command in a Rex floating layer, like `tmux popup -E`
#
# Usage: rex-popup [-w WIDTH] [-h HEIGHT] [-d DIR] [-l LABEL] [-t] CMD
#   WIDTH/HEIGHT are cells (100) or percentages of the window (50%),
#   default 50%, or 80% on small windows
#   -l labels the popup (default "popup")
#   -t closes the popup with the same label instead, if one is open
#   The layer closes when CMD exits.

# From a Rex key binding the server's PATH has no `rex`, which sits beside
# the server that started us
if ! command -v rex > /dev/null; then
  PATH="$(dirname "$(ps -o comm= -p $PPID)"):$PATH"
fi

__RX_WIDTH_DEFAULT="50%"
__RX_HEIGHT_DEFAULT="50%"
__RX_LABEL="popup"
__RX_ARG_TOGGLE=0

while [[ "$#" -gt 0 ]]; do
  case $1 in
    -w|--width)
      __RX_ARG_WIDTH=$2
      shift ;;
    -h|--height)
      __RX_ARG_HEIGHT=$2
      shift ;;
    -d)
      __RX_PWD="$2"
      shift ;;
    -l)
      __RX_LABEL="$2"
      shift ;;
    -t)
      __RX_ARG_TOGGLE=1
      ;;
    *)
      __RX_CMD=$1
      ;;
  esac
  shift
done

if [ -z "$REX_SESSION" ] || [ -z "$REX_BLOCK" ]; then
  echo "rex-popup: not running inside Rex" >&2
  exit 1
fi

__RX_VIEW=$(rex api call -s "$REX_SESSION" session.view)

if [ $__RX_ARG_TOGGLE = 1 ]; then
  __RX_LAYER=$(echo "$__RX_VIEW" | jq -r --arg l "$__RX_LABEL" \
    'first(.windows[].layers[] | select(.kind == "floating" and any(.blocks[]; .label == $l)) | .layer_id) // empty')

  if [ -n "$__RX_LAYER" ]; then
    jq -n --arg id "$__RX_LAYER" '{layer_id: $id}' \
      | rex api call -s "$REX_SESSION" session.close_layer - > /dev/null
    exit 0
  fi
fi

# Window size in cells: the block's size scaled up by its share of the window
__RX_SIZE=$(rex block call -s "$REX_SESSION" -b "$REX_BLOCK" size)
__RX_RECT=$(echo "$__RX_VIEW" | jq -c --arg b "$REX_BLOCK" \
  'first(.. | objects | select(.block_id == $b and has("rect")) | .rect) // [0, 0, 1, 1]')
read -r __RX_COLS __RX_ROWS < <(jq -rn --argjson s "$__RX_SIZE" --argjson r "$__RX_RECT" \
  '"\($s.columns / $r[2] | floor) \($s.rows / $r[3] | floor)"')

[[ $__RX_COLS -lt ${WINDOW_VIEWPORT_WIDTH_MD:-0} ]] && __RX_WIDTH_DEFAULT="80%"
[[ $__RX_ROWS -lt ${WINDOW_VIEWPORT_HEIGHT_MD:-0} ]] && __RX_HEIGHT_DEFAULT="80%"

# "50%" -> 0.5 and "100" -> 100 cells of the window, at most all of it
fraction() {
  awk -v v="$1" -v total="$2" 'BEGIN {
    f = sub(/%$/, "", v) ? v / 100 : v / total
    printf "%.4f", (f > 1 ? 1 : f)
  }'
}

__RX_W=$(fraction "${__RX_ARG_WIDTH:-$__RX_WIDTH_DEFAULT}" "$__RX_COLS")
__RX_H=$(fraction "${__RX_ARG_HEIGHT:-$__RX_HEIGHT_DEFAULT}" "$__RX_ROWS")

jq -n \
  --arg cwd "${__RX_PWD:-$PWD}" \
  --arg cmd "$__RX_CMD" \
  --arg label "$__RX_LABEL" \
  --argjson w "$__RX_W" \
  --argjson h "$__RX_H" \
  '{
    bounds: [(1 - $w) / 2, (1 - $h) / 2, $w, $h],
    focus: true,
    layout: { block: {
      flavor: "com.superlogical.terminal.shell",
      label: $label,
      options: { cwd: $cwd, command: ["sh", "-c", $cmd] }
    } }
  }' | rex api call -s "$REX_SESSION" session.new_layer - > /dev/null
