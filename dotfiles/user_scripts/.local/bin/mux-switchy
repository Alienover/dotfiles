#!/usr/bin/env bash

# mux-switchy - Fuzzy-find and switch between Rex sessions or Herdr spaces
#
# Counterpart of tmux-switchy. Lists existing sessions with fzf, or resolves a
# query against the pre-defined session mappings, then switches the app to
# that session, creating it first if it doesn't exist.
#
# Usage: mux-switchy [query]
#   Without args: Opens fzf to interactively select a session
#                 (ctrl-x closes the highlighted one)
#   With query:   Switches to session matching the query
#   --list / --kill NAME are used by the fzf bindings
#
# Backend: $MUX_BACKEND (rex|herdr), else Rex inside Rex ($REX_SESSION), else
# Herdr inside Herdr ($HC_TERMINAL_ID). A Rex session is a Herdr space.
# Herdr without a query opens its own picker, the `switchy` mod
# (~/.config/herdr-app/mods/switchy), instead of fzf.
#
# Rex: switching needs Remote Control turned on in Rex.app (Settings > Rex
# Server). Set REX_CLIENT to pick the app when several are connected.

# Define session mappings: key (for fuzzy search) -> session name (actual session)
declare -A SESSION_MAPPINGS=(
  ["term"]="🦄 term"
  ["obsidian"]="📚 Obsidian"
  ["vpn"]="🌈 vpn"
  # Add more mappings as needed
)

# Load additional mappings from optional config file: ~/.tmux_session
# Shared with tmux-switchy. File format (one mapping per line):
#   key=session_name
load_session_mappings() {
  SESSION_CONFIG="$HOME/.tmux_session"
  if [ -f "$SESSION_CONFIG" ]; then
    while IFS='=' read -r key value; do
      # Skip empty lines and comments
      [[ -z "$key" || "$key" =~ ^[[:space:]]*# ]] && continue
      # Trim whitespace
      key=$(echo "$key" | xargs)
      value=$(echo "$value" | xargs)
      # Add to mappings if both key and value are present
      if [ -n "$key" ] && [ -n "$value" ]; then
        SESSION_MAPPINGS["$key"]="$value"
      fi
    done < "$SESSION_CONFIG"
  fi
}

backend=${MUX_BACKEND:-}
if [ -z "$backend" ]; then
  if [ -n "$REX_SESSION" ]; then
    backend=rex
  elif [ -n "$HC_TERMINAL_ID" ]; then
    backend=herdr
  fi
fi
case "$backend" in
  rex|herdr) export MUX_BACKEND=$backend ;; # fzf's binds re-run this script
  *)
    echo "mux-switchy: not running inside Rex or Herdr (set MUX_BACKEND=rex|herdr)" >&2
    exit 1 ;;
esac

# --- Backend operations: list names, find an id by name, create, select, close

rex_list() { rex ls --json 2>/dev/null | jq -r '.sessions[].label'; }
rex_find() { rex ls --json | jq -r --arg s "$1" 'first(.sessions[] | select(.label == $s) | .session_id) // empty'; }
rex_create() { rex new "$1" -c "$HOME" --json | jq -r '.session_id'; }
rex_select() { rex do session.select session_id="$1"; }
rex_kill() { rex kill "$1" 2>/dev/null; }

herdr_list() { herdr-app ls 2>/dev/null | jq -r '.spaces[].name'; }
herdr_find() { herdr-app ls | jq -r --arg s "$1" 'first(.spaces[] | select(.name == $s) | .id) // empty'; }
herdr_create() { herdr-app do space.new --name "$1" --folder "$HOME" | jq -r '.space // empty'; }
herdr_select() { herdr-app do space.select --id "$1" | jq -e '.ok' > /dev/null; }
herdr_kill() {
  local id
  id=$(herdr_find "$1")
  [ -n "$id" ] && herdr-app do space.close --id "$id" --confirmed true > /dev/null
}

list_sessions() { "${backend}_list" | sort; }

case "$1" in
  --list) list_sessions; exit 0 ;;
  --kill) "${backend}_kill" "$2"; exit 0 ;;
esac

# Resolve session name from query or interactive fzf selection
resolve_session() {
  local selected_session=""
  local query="$1"
  local self
  self=$(printf '%q' "$0")

  if [ -z "$1" ]; then
    C_BG=$GUI_BACKGROUND
    C_FG=$GUI_FOREGROUND
    C_PRIMARY=$GUI_PRIMARY
    C_YELLOW=$GUI_DARK_YELLOW
    C_BLACK=$GUI_BLACK

    # Refer to https://github.com/junegunn/fzf/wiki/Color-schemes#color-configuration for more detail
    FZF_OPTIONS="
      --no-info
      --no-scrollbar
      --height=100%
      --print-query
      --style=full
      --layout=reverse
      --color fg:$C_FG,bg:$C_BG,hl:$C_PRIMARY
      --color fg+:$C_FG,bg+:$C_BLACK,hl+:$C_YELLOW
      --color gutter:$C_BG,info:$C_PRIMARY,prompt:$C_PRIMARY
      --color spinner:$C_PRIMARY,pointer:$C_BLACK,marker:$C_YELLOW,border:$C_BLACK
    "

    # shellcheck disable=SC2086 # FZF_OPTIONS is a list of flags
    query=$(list_sessions | fzf $FZF_OPTIONS --prompt "Session: " \
      --bind "ctrl-x:execute-silent($self --kill {})+reload($self --list)" \
    )
  fi

  [ -z "$query" ] && exit 0

  # When fzf is called with --print-query, it outputs 2 lines on selection:
  #   Line 1: The user's search query
  #   Line 2: The selected item
  # If we got 2 lines, extract the selected item (line 2) and return it
  if [ "$(echo "$query" | wc -l )" -eq 2 ]; then
    echo "$query" | tail -n 1
    exit 0
  fi

  load_session_mappings

  selected_session="${SESSION_MAPPINGS[$query]}"

  if [ -z "$selected_session" ]; then
    all_keys=""
    for key in "${!SESSION_MAPPINGS[@]}"; do
      all_keys="${all_keys}${key}\n"
    done
    query="$(echo -e "$all_keys" | sed '/^$/d' | fzf --filter="$query" | head -n 1)"

    [ -n "$query" ] && selected_session="${SESSION_MAPPINGS[$query]}"
  fi

  echo "$selected_session"
}

# Switches the app to the session, or creates it if it doesn't exist
switch_to_session() {
  local session="$1"
  local session_id

  if [ -z "$session" ]; then
    echo "No project selected!"
    return
  fi

  session_id=$("${backend}_find" "$session")
  if [ -z "$session_id" ]; then
    session_id=$("${backend}_create" "$session")
  fi

  "${backend}_select" "$session_id" || {
    echo "Press any key to close"
    read -rsn1
  }
}

if [ -z "$1" ] && [ "$backend" = herdr ]; then
  herdr-app do mod.open --name switchy > /dev/null
  exit
fi

switch_to_session "$(resolve_session "$1")"
