#!/bin/bash

file="${f:-${1}}"
selected_files=()

if [ -n "$fx" ]; then
  for arg in "${fx[@]}"; do
    selected_files+=("$arg")
  done
elif [ "$#" -gt 0 ]; then
  for arg in "$@"; do
    selected_files+=("$arg")
  done
fi

open_in_editor() {
  if [ -n "$id" ]; then
    lf -remote "send $id \$$EDITOR -- \$fx"
    return 0
  fi

  # lf ran in a tmux popup and has exited; open the files in the pane underneath
  if [ -n "$TMUX_LF" ]; then
    local pane
    pane=$(tmux display -p "#{pane_id}")
    case $(tmux display -p -t "$pane" "#{pane_current_command}") in
      *vim)
        # Build a vim list of single-quoted paths ('' escapes a quote)
        local list="" path q="'"
        for path in "${selected_files[@]}"; do
          list+="$q${path//$q/$q$q}$q,"
        done
        # <C-\><C-n> reaches normal mode from any mode without the <Esc> timeout
        # (nvim reads a fast <Esc>: as <M-:>). `tab drop` reuses a tab if the
        # file is already open, and fnameescape handles spaces, %, #, etc.
        tmux send-keys -t "$pane" 'C-\' C-n
        tmux send-keys -t "$pane" -l ":execute 'tab drop' join(map([${list%,}], 'fnameescape(v:val)'))"
        tmux send-keys -t "$pane" Enter
        ;;
      bash|zsh|fish|sh|-bash|-zsh)
        # -l sends the text literally so names like "Enter" aren't read as keys
        tmux send-keys -t "$pane" -l "$EDITOR -- $(printf '%q ' "${selected_files[@]}")"
        tmux send-keys -t "$pane" Enter
        ;;
      *)
        tmux new-window $EDITOR -- "${selected_files[@]}"
        ;;
    esac
    return 0
  fi

  $EDITOR "${selected_files[@]}"
}

case $(file --mime-type -Lb -- "$file") in
  video/*)
    mpv --keep-open=yes "${selected_files[@]}"
    ;;
  text/*|*/json|inode/x-empty|application/javascript)
    open_in_editor
    ;;
  *)
    open "${selected_files[@]}"
    ;;
esac
