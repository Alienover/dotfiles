#!/usr/bin/env bash
# Reach a DevPod workspace's Rex server as a Rex host over `rex -S ssh://WS.devpod`.
#
# Stock DevPod's SSH server refuses Unix-socket forwarding, which ssh:// needs;
# the workspace's agent has to carry the patch in
# ~/src/dotfiles/install/darwin/patches/devpod (see RECIPE.md there).
#
# Rex opens its own `ssh -N -L sock:sock` tunnel for ssh:// hosts. This script
# makes sure what's behind it is right: the container's Rex server runs with
# the workspace's environment (Rex's autostart would strip it), and an ssh
# session stays open so the server's SSH_AUTH_SOCK points at a live forwarded
# agent (a -N tunnel carries no agent). It then registers the host as WS, with
# endpoint ssh://WS.devpod, for `rex -S WS`.
set -euo pipefail

RECIPE="$HOME/src/dotfiles/install/darwin/patches/devpod/RECIPE.md"

usage() {
	cat <<EOF
Usage: $(basename "$0") [--down | [--install] [--upgrade]] [--all | WORKSPACE]

Without WORKSPACE, pick one of your DevPod workspaces with fzf. With --all, run
for every DevPod workspace in turn.

Start WORKSPACE if needed, start its Rex server with the workspace's
environment, keep an ssh session open that forwards your SSH agent to it, and
add the Rex host WORKSPACE at ssh://WORKSPACE.devpod (for rex -S WORKSPACE).
Safe to re-run whenever the host stops answering or git can't reach your keys
(sleep, container restart, dropped connection).

Needs the workspace's devpod agent patched for Unix socket forwarding:
see $RECIPE

A server older than the installed rex, or started without the workspace's
environment (e.g. autostarted by rex -S ssh://), is restarted, unless it holds
sessions.

Options:
  --down      close the agent session and stop the container's Rex server
              (the host entry is kept)
  --install   install rex in the container first if it's missing (e.g. after
              a recreate); does nothing when rex is already there
  --upgrade   upgrade rex in the container with apt first
  --all       every DevPod workspace (devpod list), one after another with the
              other options; keeps going if one fails, exits 1 if any did
  -h, --help  show this help

Environment:
  REX_DEVPOD_CHANNEL  release channel for --install (default: preview)

Requires rex in the container; --install puts it there.
EOF
}

die() {
	echo "rex-devpod: $*" >&2
	exit 1
}
log() { echo "==> $*"; }

DOWN=0
INSTALL=0
UPGRADE=0
ALL=0
CHANNEL="${REX_DEVPOD_CHANNEL:-preview}"
WS=""
while [ $# -gt 0 ]; do
	case "$1" in
	--down) DOWN=1 ;;
	--install) INSTALL=1 ;;
	--upgrade) UPGRADE=1 ;;
	--all) ALL=1 ;;
	-h | --help)
		usage
		exit 0
		;;
	-*) die "unknown option: $1" ;;
	*)
		[ -z "$WS" ] || die "only one workspace at a time"
		WS="$1"
		;;
	esac
	shift
done
[ "$DOWN" = 0 ] || [ "$INSTALL$UPGRADE" = 00 ] || die "--down doesn't go with --install or --upgrade"

if [ "$ALL" = 1 ]; then
	[ -z "$WS" ] || die "--all doesn't take a workspace"
	command -v devpod >/dev/null || die "devpod not found"
	flags=()
	[ "$DOWN" = 1 ] && flags+=(--down)
	[ "$INSTALL" = 1 ] && flags+=(--install)
	[ "$UPGRADE" = 1 ] && flags+=(--upgrade)
	workspaces="$(devpod list --output json | jq -r '.[].id')"
	[ -n "$workspaces" ] || die "no DevPod workspaces (see: devpod list)"
	failed=()
	for ws in $workspaces; do
		echo "━━ $ws"
		# </dev/null: the per-workspace run reads stdin (fzf, ssh) and must not eat the list
		"$0" ${flags[@]+"${flags[@]}"} "$ws" </dev/null || failed+=("$ws")
	done
	if [ ${#failed[@]} -gt 0 ]; then
		echo "rex-devpod: failed: ${failed[*]}" >&2
		exit 1
	fi
	exit 0
fi
if [ -z "$WS" ]; then
	command -v fzf >/dev/null || die "no workspace given and fzf not found"
	prompt="rex-devpod> "
	[ "$DOWN" = 1 ] && prompt="rex-devpod --down> "
	WS="$(devpod list --output json | jq -r '.[].id' | fzf --prompt="$prompt" --height=~40% --reverse)" || true
	[ -n "$WS" ] || die "no workspace selected"
fi

HOST="$WS.devpod"
ENDPOINT="ssh://$HOST"
# Marks the agent session's remote command, so it can be found with pgrep -f
AGENT_MARK="rex-devpod-agent=$WS"

agent_session_pids() { pgrep -f -- "$AGENT_MARK" 2>/dev/null || true; }

# The TCP tunnel earlier versions of this script opened, if one is left
close_legacy_tunnel() { pkill -f -- "-L 127.0.0.1:[0-9]+:127.0.0.1:7297 .*$HOST " 2>/dev/null || true; }

close_sessions() {
	pkill -f -- "$AGENT_MARK" 2>/dev/null || true
	close_legacy_tunnel
}

# host_id of the Rex server answering at ENDPOINT, if any
endpoint_host_id() {
	{ rex --autostart=false --timeout 15s -S "$ENDPOINT" whoami --json 2>/dev/null || true; } | jq -r '.host_id // empty'
}

# Label of the Rex host whose endpoints include ENDPOINT
host_label() {
	rex hosts list --json | jq -r --arg e "$ENDPOINT" \
		'first(.hosts[].host | select(.endpoints | index($e)) | .label) // empty'
}

# Whether a Rex host is labelled WS (any case)
host_label_taken() {
	rex hosts list --json | jq -e --arg l "$WS" \
		'any(.hosts[].host; .label | ascii_downcase == ($l | ascii_downcase))' >/dev/null
}

if [ "$DOWN" = 1 ]; then
	log "closing the agent session for $WS"
	close_sessions
	log "stopping Rex server in $WS"
	ssh "$HOST" 'rex server stop' || true
	exit 0
fi

command -v rex >/dev/null || die "rex not found on this machine"
command -v devpod >/dev/null || die "devpod not found"

# 1. Workspace running
state="$(devpod status "$WS" --output json 2>/dev/null | jq -r '.state // empty')"
[ -n "$state" ] || die "no DevPod workspace named '$WS' (see: devpod list)"
if [ "$state" != "Running" ]; then
	log "starting workspace $WS ($state)"
	devpod up "$WS" --ide none
fi

# Before changing anything: ssh:// needs the patched devpod agent. Ask for a
# socket that doesn't exist; a stock agent refuses before even trying it.
# (ssh always fails here, so take its output rather than piping it: pipefail.)
probe="$(ssh -o LogLevel=info -W /nonexistent/rex-devpod-probe.sock "$HOST" </dev/null 2>&1 || true)"
case "$probe" in
*'unix forwarding is disabled'*)
	die "$WS's devpod agent refuses Unix socket forwarding, which rex -S ssh:// needs; patch it: $RECIPE"
	;;
esac

# 2. Container's Rex server, with the workspace's environment. Prints its host
#    ID and whether the agent link is live.
#    Launched with `rex server run` rather than `rex server start`, because start
#    strips the environment and DEVPOD_WORKSPACE_ID has to reach its terminals.
log "checking Rex server in $WS"
remote_state="$({
	cat <<EOF
set -e
ws=$(printf '%q' "$WS")
install=$INSTALL
channel=$(printf '%q' "$CHANNEL")
upgrade=$UPGRADE
EOF
	cat <<'EOF'
if ! command -v rex >/dev/null; then
	if [ "$install" != 1 ]; then
		echo "rex is not installed in the container; re-run with --install" >&2
		exit 1
	fi
	echo "==> installing rex ($channel channel)" >&2
	# stdout carries the host ID back, so the installer's output goes to stderr
	curl -fsSL https://pkgs.superlogical.com/rex/install.sh | sh -s -- --channel "$channel" >&2
	command -v rex >/dev/null || { echo "rex install failed" >&2; exit 1; }
	echo "==> installed $(rex version | sed -n 1p)" >&2
fi
installed_version() { rex version | sed -n '1s/^rex //p'; }
if [ "$upgrade" = 1 ]; then
	before="$(installed_version)"
	echo "==> upgrading rex ($before)" >&2
	# stdout carries the host ID back, so apt's output goes to stderr
	sudo apt-get update -qq >&2
	sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --only-upgrade rex >&2
	after="$(installed_version)"
	if [ "$after" = "$before" ]; then
		echo "==> rex is up to date ($after)" >&2
	else
		echo "==> rex upgraded: $before -> $after" >&2
	fi
fi
installed="$(installed_version)"
agent="$HOME/.local/state/rex/ssh-agent.sock"
status="$(rex server status 2>/dev/null || true)"
field() { printf '%s\n' "$status" | sed -n "s/^$1: //p"; }
server_has_env() { tr '\0' '\n' <"/proc/$(field pid)/environ" | grep -qxF "$1"; }

if [ -n "$status" ]; then
	why=""
	if [ "$(field version)" != "$installed" ]; then
		why="to run the installed version $installed (it runs $(field version))"
	elif ! server_has_env "DEVPOD_WORKSPACE_ID=$ws"; then
		why="to get DEVPOD_WORKSPACE_ID=$ws"
	elif ! server_has_env "SSH_AUTH_SOCK=$agent"; then
		why="to get SSH_AUTH_SOCK=$agent"
	elif ! server_has_env "DEVPOD=true"; then
		why="to get DEVPOD=true"
	elif printf '%s\n' "$status" | grep -q '^listener: http://127\.0\.0\.1:'; then
		# Left by earlier versions of this script; ssh:// doesn't need it
		why="to drop its anonymous TCP listener"
	fi
	if [ -n "$why" ]; then
		if [ "$(field sessions)" != 0 ]; then
			echo "Rex server needs a restart $why, but holds $(field sessions) session(s)." >&2
			echo "Restarting it would end them; stop it yourself (rex server stop) and re-run." >&2
			echo "Continuing with the running server." >&2
		else
			rex server stop >/dev/null
			status=""
		fi
	fi
fi

if [ -z "$status" ]; then
	# The same variables `rex server start` keeps, plus DEVPOD_WORKSPACE_ID.
	# SSH_AUTH_SOCK is a stable link the agent session points at its forwarded
	# agent; this session's own socket dies as soon as this ssh exits.
	# DEVPOD=true marks the terminals as remote (env -i drops SSH_*), so tools
	# such as nvim copy through OSC 52 to the Mac clipboard.
	vars=(HOME="$HOME" PATH="$PATH" DEVPOD=true DEVPOD_WORKSPACE_ID="$ws" SSH_AUTH_SOCK="$agent")
	for v in USER LOGNAME SHELL LANG LC_ALL; do
		[ -n "${!v-}" ] && vars+=("$v=${!v}")
	done
	log="$HOME/.local/state/rex/devpod-server.log"
	mkdir -p "${log%/*}"
	env -i "${vars[@]}" setsid -f rex server run </dev/null >"$log" 2>&1
	for _ in $(seq 20); do
		status="$(rex --autostart=false server status 2>/dev/null || true)"
		[ -n "$status" ] && break
		sleep 0.5
	done
	[ -n "$status" ] || { echo "Rex server didn't come up; see $log" >&2; exit 1; }
	echo "Rex server running (pid $(field pid), log $log)" >&2
fi
printf '%s %s\n' "$(field host)" "$([ -S "$agent" ] && echo agent || echo no-agent)"
EOF
} | ssh "$HOST" bash -s)"
read -r remote_host_id agent_state <<<"$remote_state"
[ -n "$remote_host_id" ] || die "couldn't read the host ID of the Rex server in $WS"

# 3. Agent session: keeps a forwarded SSH agent alive and points the server's
#    SSH_AUTH_SOCK link at it. Rex's own ssh:// tunnel runs -N, which has none.
#    Also closes the TCP tunnel earlier versions of this script opened.
close_legacy_tunnel
if [ "$agent_state" = agent ] && [ -n "$(agent_session_pids)" ]; then
	log "agent session already open"
else
	pkill -f -- "$AGENT_MARK" 2>/dev/null || true
	log "opening agent session"
	DEVPOD_WORKSPACE_ID="$WS" ssh -f -T \
		-o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
		"$HOST" \
		": $AGENT_MARK; [ -S \"\$SSH_AUTH_SOCK\" ] && ln -sfn \"\$SSH_AUTH_SOCK\" ~/.local/state/rex/ssh-agent.sock; exec sleep infinity"
fi

# 4. Rex answers over ssh://
[ "$(endpoint_host_id)" = "$remote_host_id" ] ||
	die "Rex in $WS doesn't answer at $ENDPOINT (try: rex -v -S $ENDPOINT whoami)"
log "Rex in $WS answers at $ENDPOINT"

# 5. Host entry
label="$(host_label)"
if [ -n "$label" ]; then
	log "host '$label' has $ENDPOINT"
elif host_label_taken; then
	# e.g. the http://WS.localhost:PORT endpoint earlier versions used
	log "pointing host '$WS' at $ENDPOINT"
	rex hosts edit "$WS" --endpoint "$ENDPOINT" >/dev/null
	label="$WS"
else
	log "adding host '$WS' at $ENDPOINT"
	rex hosts add "$WS" "$ENDPOINT" >/dev/null
	label="$WS"
fi

log "ready: rex -S $label new NAME"
