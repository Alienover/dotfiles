#!/usr/bin/env bash
# Reach a DevPod workspace's Rex server as a Rex host.
#
# DevPod's SSH server refuses Unix-socket forwarding, so `rex -S ssh://WS.devpod`
# can't work. Instead the container's Rex server also listens on its own
# loopback (127.0.0.1:REMOTE_PORT), and an ssh TCP forward exposes that on the
# Mac at WS.localhost:LOCAL_PORT. LOCAL_PORT is derived from the workspace
# name, so the endpoint stays the same across runs and only has to be added to
# the Rex app once. The app names a host after the endpoint's hostname
# (WS.localhost) and syncs it into `rex hosts` for `rex -S WS.localhost`.
set -euo pipefail

REMOTE_PORT=7297
PORT_BASE=47000
PORT_RANGE=1000

usage() {
	cat <<EOF
Usage: $(basename "$0") [--down | [--install] [--upgrade]] [--all | WORKSPACE]

Without WORKSPACE, pick one of your DevPod workspaces with fzf. With --all, run
for every DevPod workspace in turn.

Start WORKSPACE if needed, start its Rex server with a loopback TCP listener,
open an ssh tunnel to it at http://WORKSPACE.localhost:PORT (PORT is fixed
per workspace). If no Rex host has that endpoint yet, copy it and open the Rex
app's Add Remote Host dialog; the app then lists the host as
WORKSPACE.localhost, for rex -S too. Safe to re-run whenever the host stops answering
(sleep, container restart, dropped tunnel).

A server older than the installed rex is restarted onto it, unless it holds
sessions.

Options:
  --down      close the tunnel and stop the container's Rex server
              (the host entry is kept)
  --install   install rex in the container first if it's missing (e.g. after
              a recreate); does nothing when rex is already there
  --upgrade   upgrade rex in the container with apt first
  --all       every DevPod workspace (devpod list), one after another with the
              other options; keeps going if one fails, exits 1 if any did
  -h, --help  show this help

Environment:
  REX_DEVPOD_PORT     local port to use instead of the derived one
  REX_DEVPOD_CHANNEL  release channel for --install (default: preview)

Requires rex in the container; --install puts it there.
EOF
}

die() {
	echo "rex-devpod: $*" >&2
	exit 1
}
log() { echo "==> $*"; }

DOWN=0
INSTALL=0
UPGRADE=0
ALL=0
CHANNEL="${REX_DEVPOD_CHANNEL:-preview}"
WS=""
while [ $# -gt 0 ]; do
	case "$1" in
	--down) DOWN=1 ;;
	--install) INSTALL=1 ;;
	--upgrade) UPGRADE=1 ;;
	--all) ALL=1 ;;
	-h | --help)
		usage
		exit 0
		;;
	-*) die "unknown option: $1" ;;
	*)
		[ -z "$WS" ] || die "only one workspace at a time"
		WS="$1"
		;;
	esac
	shift
done
[ "$DOWN" = 0 ] || [ "$INSTALL$UPGRADE" = 00 ] || die "--down doesn't go with --install or --upgrade"

if [ "$ALL" = 1 ]; then
	[ -z "$WS" ] || die "--all doesn't take a workspace"
	command -v devpod >/dev/null || die "devpod not found"
	flags=()
	[ "$DOWN" = 1 ] && flags+=(--down)
	[ "$INSTALL" = 1 ] && flags+=(--install)
	[ "$UPGRADE" = 1 ] && flags+=(--upgrade)
	workspaces="$(devpod list --output json | jq -r '.[].id')"
	[ -n "$workspaces" ] || die "no DevPod workspaces (see: devpod list)"
	failed=()
	for ws in $workspaces; do
		echo "━━ $ws"
		# </dev/null: the per-workspace run reads stdin (fzf, ssh) and must not eat the list
		"$0" ${flags[@]+"${flags[@]}"} "$ws" </dev/null || failed+=("$ws")
	done
	if [ ${#failed[@]} -gt 0 ]; then
		echo "rex-devpod: failed: ${failed[*]}" >&2
		exit 1
	fi
	exit 0
fi
if [ -z "$WS" ]; then
	command -v fzf >/dev/null || die "no workspace given and fzf not found"
	prompt="rex-devpod> "
	[ "$DOWN" = 1 ] && prompt="rex-devpod --down> "
	WS="$(devpod list --output json | jq -r '.[].id' | fzf --prompt="$prompt" --height=~40% --reverse)" || true
	[ -n "$WS" ] || die "no workspace selected"
fi

HOST="$WS.devpod"
LOCAL_PORT="${REX_DEVPOD_PORT:-$((PORT_BASE + $(printf '%s' "$WS" | cksum | cut -d' ' -f1) % PORT_RANGE))}"
ENDPOINT="http://$WS.localhost:$LOCAL_PORT"
FORWARD="127.0.0.1:$LOCAL_PORT:127.0.0.1:$REMOTE_PORT"
FORWARD6="[::1]:$LOCAL_PORT:127.0.0.1:$REMOTE_PORT"

# host_id of the Rex server answering at ENDPOINT, if any
endpoint_host_id() {
	{ rex --autostart=false --timeout 5s -S "$ENDPOINT" whoami --json 2>/dev/null || true; } | jq -r '.host_id // empty'
}

kill_tunnel() {
	pkill -f -- "-L $FORWARD" 2>/dev/null || true
}

# Label of the Rex host (app-added hosts included) whose endpoint is ENDPOINT
host_label() {
	rex hosts list --json | jq -r --arg e "$ENDPOINT" \
		'first(.hosts[].host | select(.endpoints | index($e)) | .label) // empty'
}

if [ "$DOWN" = 1 ]; then
	log "closing tunnel ($ENDPOINT)"
	kill_tunnel
	log "stopping Rex server in $WS"
	ssh "$HOST" 'rex server stop' || true
	exit 0
fi

command -v rex >/dev/null || die "rex not found on this machine"
command -v devpod >/dev/null || die "devpod not found"

# 1. Workspace running
state="$(devpod status "$WS" --output json 2>/dev/null | jq -r '.state // empty')"
[ -n "$state" ] || die "no DevPod workspace named '$WS' (see: devpod list)"
if [ "$state" != "Running" ]; then
	log "starting workspace $WS ($state)"
	devpod up "$WS" --ide none
fi

# 2. Container's Rex server, with the loopback listener. Prints its host ID.
#    Launched with `rex server run` rather than `rex server start`, because start
#    strips the environment and DEVPOD_WORKSPACE_ID has to reach its terminals.
log "checking Rex server in $WS"
remote_host_id="$({
	cat <<EOF
set -e
port=$REMOTE_PORT
ws=$(printf '%q' "$WS")
install=$INSTALL
channel=$(printf '%q' "$CHANNEL")
upgrade=$UPGRADE
EOF
	cat <<'EOF'
if ! command -v rex >/dev/null; then
	if [ "$install" != 1 ]; then
		echo "rex is not installed in the container; re-run with --install" >&2
		exit 1
	fi
	echo "==> installing rex ($channel channel)" >&2
	# stdout carries the host ID back, so the installer's output goes to stderr
	curl -fsSL https://pkgs.superlogical.com/rex/install.sh | sh -s -- --channel "$channel" >&2
	command -v rex >/dev/null || { echo "rex install failed" >&2; exit 1; }
	echo "==> installed $(rex version | sed -n 1p)" >&2
fi
installed_version() { rex version | sed -n '1s/^rex //p'; }
if [ "$upgrade" = 1 ]; then
	before="$(installed_version)"
	echo "==> upgrading rex ($before)" >&2
	# stdout carries the host ID back, so apt's output goes to stderr
	sudo apt-get update -qq >&2
	sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --only-upgrade rex >&2
	after="$(installed_version)"
	if [ "$after" = "$before" ]; then
		echo "==> rex is up to date ($after)" >&2
	else
		echo "==> rex upgraded: $before -> $after" >&2
	fi
fi
installed="$(installed_version)"
agent="$HOME/.local/state/rex/ssh-agent.sock"
status="$(rex server status 2>/dev/null || true)"
field() { printf '%s\n' "$status" | sed -n "s/^$1: //p"; }
server_has_env() { tr '\0' '\n' <"/proc/$(field pid)/environ" | grep -qxF "$1"; }

if [ -n "$status" ]; then
	why=""
	if ! printf '%s\n' "$status" | grep -q "listener: http://127.0.0.1:$port "; then
		why="the 127.0.0.1:$port listener"
	elif [ "$(field version)" != "$installed" ]; then
		why="the installed version $installed (it runs $(field version))"
	elif ! server_has_env "DEVPOD_WORKSPACE_ID=$ws"; then
		why="DEVPOD_WORKSPACE_ID=$ws"
	elif ! server_has_env "SSH_AUTH_SOCK=$agent"; then
		why="SSH_AUTH_SOCK=$agent"
	elif ! server_has_env "DEVPOD=true"; then
		why="DEVPOD=true"
	fi
	if [ -n "$why" ]; then
		if [ "$(field sessions)" != 0 ]; then
			echo "Rex server is running without $why and holds $(field sessions) session(s)." >&2
			echo "Restarting it would end them; stop it yourself (rex server stop) and re-run." >&2
			case "$why" in *listener) exit 1 ;; *) echo "Continuing with the running server." >&2 ;; esac
		else
			rex server stop >/dev/null
			status=""
		fi
	fi
fi

if [ -z "$status" ]; then
	# The same variables `rex server start` keeps, plus DEVPOD_WORKSPACE_ID.
	# SSH_AUTH_SOCK is a stable link the tunnel session points at its forwarded
	# agent; this session's own socket dies as soon as this ssh exits.
	# DEVPOD=true marks the terminals as remote (env -i drops SSH_*), so tools
	# such as nvim copy through OSC 52 to the Mac clipboard.
	vars=(HOME="$HOME" PATH="$PATH" DEVPOD=true DEVPOD_WORKSPACE_ID="$ws" SSH_AUTH_SOCK="$agent")
	for v in USER LOGNAME SHELL LANG LC_ALL; do
		[ -n "${!v-}" ] && vars+=("$v=${!v}")
	done
	log="$HOME/.local/state/rex/devpod-server.log"
	mkdir -p "${log%/*}"
	env -i "${vars[@]}" setsid -f rex server run \
		--extra-listen "http://127.0.0.1:$port" --allow-anonymous \
		</dev/null >"$log" 2>&1
	for _ in $(seq 20); do
		status="$(rex --autostart=false server status 2>/dev/null || true)"
		[ -n "$status" ] && break
		sleep 0.5
	done
	[ -n "$status" ] || { echo "Rex server didn't come up; see $log" >&2; exit 1; }
	echo "Rex server running (pid $(field pid), log $log)" >&2
fi
printf '%s %s\n' "$(field host)" "$([ -S "$agent" ] && echo agent || echo no-agent)"
EOF
} | ssh "$HOST" bash -s)"
read -r remote_host_id agent_state <<<"$remote_host_id"
[ -n "$remote_host_id" ] || die "couldn't read the host ID of the Rex server in $WS"

# 3. Tunnel: 127.0.0.1:LOCAL_PORT -> container 127.0.0.1:REMOTE_PORT, plus a
#    session that keeps the forwarded SSH agent alive for the server
current="$(endpoint_host_id)"
if [ "$current" = "$remote_host_id" ] && [ "$agent_state" = agent ]; then
	log "tunnel already up ($ENDPOINT)"
else
	[ -z "$current" ] || [ "$current" = "$remote_host_id" ] ||
		die "port $LOCAL_PORT is taken by another Rex server; set REX_DEVPOD_PORT to another port"
	kill_tunnel
	for _ in 1 2 3 4 5; do
		nc -z 127.0.0.1 "$LOCAL_PORT" 2>/dev/null || break
		sleep 0.5
	done
	if nc -z 127.0.0.1 "$LOCAL_PORT" 2>/dev/null; then
		die "port $LOCAL_PORT is taken by something else; set REX_DEVPOD_PORT to another port"
	fi
	log "opening tunnel ($ENDPOINT)"
	# Not -N: a forwarded agent only exists inside a session, so the tunnel runs
	# one that points the server's SSH_AUTH_SOCK link at it and then idles.
	DEVPOD_WORKSPACE_ID="$WS" ssh -f -T \
		-o ExitOnForwardFailure=yes \
		-o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
		-L "$FORWARD" -L "$FORWARD6" "$HOST" \
		'[ -S "$SSH_AUTH_SOCK" ] && ln -sfn "$SSH_AUTH_SOCK" ~/.local/state/rex/ssh-agent.sock; exec sleep infinity'
	for _ in 1 2 3 4 5; do
		[ "$(endpoint_host_id)" = "$remote_host_id" ] && break
		sleep 1
	done
	[ "$(endpoint_host_id)" = "$remote_host_id" ] || die "tunnel opened but Rex in $WS doesn't answer at $ENDPOINT"
fi

# 4. Host entry. Only the Rex app can add one it will show, so ask it to.
label="$(host_label)"
if [ -n "$label" ]; then
	log "host '$label' has $ENDPOINT"
else
	log "add $ENDPOINT in the Rex app (Add Remote Host…), once per workspace"
	printf '%s' "$ENDPOINT" | pbcopy 2>/dev/null && log "endpoint copied to the clipboard"
	rex do client.host.add >/dev/null 2>&1 || true
fi

log "ready: rex -S ${label:-$ENDPOINT} new NAME"
